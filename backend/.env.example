# Copy this file to ".env" and fill in your own values.

PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/rhythora
# MongoDB Atlas (cloud) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rhythora?retryWrites=true&w=majority

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Optional: only needed if the frontend is hosted on a DIFFERENT domain (comma separated)
# CLIENT_URL=https://your-frontend.vercel.app

# Admin account created automatically the first time the server starts on an empty database
ADMIN_EMAIL=admin@rhythora.dance
ADMIN_PASSWORD=Admin@123
